{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"strict": true,
		"skipLibCheck": true,
		"allowJs": true,
		"incremental": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"plugins": [{ "name": "next" }]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"*.ts",
		"tests/**/*.ts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"next-env.d.ts"
	],
	"exclude": ["node_modules"]
}
