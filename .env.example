# Copy this file to .env. Only these two token values are required.
# Never commit .env or paste tokens into chat.
AZURE_DEVOPS_PAT=
COPILOT_GITHUB_TOKEN=

# Optional connection/model settings. Select sources in the app's Settings page.
# New and upgraded installations start with no Work Item Sources or repositories.
# AZURE_DEVOPS_ORG=vertigis
# COPILOT_MODEL=gpt-4.1
# SYNC_INTERVAL_SECONDS=180
# AZURE_DEVOPS_USER_EMAIL=

# Deprecated and ignored: AZURE_DEVOPS_PROJECTS, AZURE_DEVOPS_REPOSITORY_IDS.
